<svg viewBox="0 0 680 360" role="img" aria-labelledby="chart-title chart-desc" class="chart">
<title id="chart-title">Report length against judged quality</title>
<desc id="chart-desc">Each mark is one report. Horizontal position is reading length as a percentage of the same topic's baseline; vertical position is the blind judge total divided by the baseline total. Distill and hybrid sit up and to the left of the baselines; budget alone sits lowest among short reports on isolation.</desc>
<line x1="64" x2="656" y1="304.0" y2="304.0" class="grid"/><text x="56" y="308.0" class="tick" text-anchor="end">0.9×</text>
<line x1="64" x2="656" y1="209.3" y2="209.3" class="grid base"/><text x="56" y="213.3" class="tick" text-anchor="end">1.0×</text>
<line x1="64" x2="656" y1="114.7" y2="114.7" class="grid"/><text x="56" y="118.7" class="tick" text-anchor="end">1.1×</text>
<line x1="64" x2="656" y1="20.0" y2="20.0" class="grid"/><text x="56" y="24.0" class="tick" text-anchor="end">1.2×</text>
<line x1="64.0" x2="64.0" y1="20" y2="304" class="grid"/><text x="64.0" y="322" class="tick" text-anchor="middle">0%</text>
<line x1="192.7" x2="192.7" y1="20" y2="304" class="grid"/><text x="192.7" y="322" class="tick" text-anchor="middle">25%</text>
<line x1="321.4" x2="321.4" y1="20" y2="304" class="grid"/><text x="321.4" y="322" class="tick" text-anchor="middle">50%</text>
<line x1="450.1" x2="450.1" y1="20" y2="304" class="grid"/><text x="450.1" y="322" class="tick" text-anchor="middle">75%</text>
<line x1="578.8" x2="578.8" y1="20" y2="304" class="grid"/><text x="578.8" y="322" class="tick" text-anchor="middle">100%</text>
<text x="360.0" y="348" class="axis" text-anchor="middle">Reading length, % of baseline</text>
<text transform="translate(16 162.0) rotate(-90)" class="axis" text-anchor="middle">Judge score vs baseline</text>
<circle cx="583.9" cy="209.3" r="6" class="mk baseline"/>
<circle cx="573.6" cy="209.3" r="6" class="mk baseline"/>
<rect x="532.1" y="214.2" width="11" height="11" class="mk baseline"/>
<rect x="614.5" y="193.4" width="11" height="11" class="mk baseline"/>
